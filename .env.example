# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริงของตัวเอง
# ห้ามใส่ credential จริงในไฟล์นี้เด็ดขาด (เคยมีการ leak มาก่อน)
DATABASE_URL="mysql://user:password@localhost:3306/skill_app"
BETTER_AUTH_SECRET="เปลี่ยนเป็น secret ยาว ๆ ของตัวเอง"
BETTER_AUTH_URL="http://localhost:3000"
WEATHER_API_KEY="your-weatherapi-key"